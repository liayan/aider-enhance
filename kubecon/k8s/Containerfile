# In-cluster image for the KubeCon demo. Build from the repo root:
#   podman build -t agent-lab:1 -f kubecon/k8s/Containerfile .
#   podman build --build-arg WITH_AIDER=1 -t agent-lab:1 -f kubecon/k8s/Containerfile .
# Unlike the local backends, nothing is bind-mounted from a host, so the lab
# code and workload are baked in. Pin BASE_IMAGE by digest for real runs.
ARG BASE_IMAGE=docker.io/library/python:3.12-slim-bookworm
FROM ${BASE_IMAGE}
RUN apt-get update && apt-get install -y --no-install-recommends git \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --uid 1000 --create-home --shell /usr/sbin/nologin agent
ARG WITH_AIDER=0
ARG AIDER_VERSION=0.86.2
RUN if [ "$WITH_AIDER" = 1 ]; then \
      pip install --no-cache-dir --break-system-packages "aider-chat==${AIDER_VERSION}"; \
    fi
COPY src/ /src/
COPY workload/ /opt/workload/
USER 1000:1000
WORKDIR /work
ENV HOME=/tmp/home PYTHONDONTWRITEBYTECODE=1 SRC=/src
ENTRYPOINT ["/bin/bash", "/src/common/inside.sh"]
