# Pinned inputs. Everything that must stay constant across backends lives here.
# Change a value -> policy digest changes -> results are no longer comparable.
AIDER_VERSION=0.86.1                     # pin to the exact version you rehearsed with
PYTHON_MIN=3.10
DEMO_MODEL=${DEMO_MODEL:-openai/gpt-4o-mini}   # model id passed to aider (real-agent mode only)
DEMO_MODEL_TEMPERATURE=0
MODEL_UPSTREAM=${MODEL_UPSTREAM:-https://api.openai.com}  # gateway upstream (host side only)
CONTAINER_IMAGE=localhost/agent-sandbox-demo:1
BASE_IMAGE=docker.io/library/python:3.12-slim-bookworm   # pin by digest before the talk: ...@sha256:<digest>
FC_VCPUS=1
FC_MEM_MIB=1024
# Resource budget, identical for every backend where technically comparable
LIMIT_MEM=1G
LIMIT_PIDS=128
LIMIT_CPUS=1
RUN_TIMEOUT_SEC=600
