# Minimal image for the workload. Pin BASE_IMAGE by digest before the talk.
# Build:  podman build -t agent-sandbox-demo:1 -f Containerfile ..
ARG BASE_IMAGE=docker.io/library/python:3.12-slim-bookworm
FROM ${BASE_IMAGE}

# Non-root identity baked in; the launcher also enforces --user.
RUN useradd --uid 1000 --create-home --shell /usr/sbin/nologin agent
# The lab code is mounted read-only at run time, not copied, so the image stays
# generic. For agent mode, install the pinned agent runtime into the image:
#   (kept commented so emulate-mode builds stay tiny; uncomment for --agent)
# RUN pip install --no-cache-dir --break-system-packages "aider-chat==0.86.2"

USER 1000:1000
WORKDIR /work
ENV HOME=/tmp/home PYTHONDONTWRITEBYTECODE=1
ENTRYPOINT ["/bin/bash", "/lab/common/inside.sh"]
