# Inputs that must match across backends. Results from runs with different
# values aren't comparable.
AIDER_VERSION=0.86.2
PYTHON_MIN=3.10
DEMO_MODEL=${DEMO_MODEL:-openai/gpt-4o-mini}   # agent mode only
DEMO_MODEL_TEMPERATURE=0
MODEL_UPSTREAM=${MODEL_UPSTREAM:-https://api.openai.com}  # used by the host gateway
CONTAINER_IMAGE=localhost/agent-sandbox-demo:1
BASE_IMAGE=docker.io/library/python:3.12-slim-bookworm   # pin by digest for real runs
FC_VCPUS=1
FC_MEM_MIB=1024
# Resource limits, same for every backend where the mechanism allows
LIMIT_MEM=1G
LIMIT_PIDS=128
LIMIT_CPUS=1
RUN_TIMEOUT_SEC=600
