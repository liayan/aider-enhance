# Build from the repo root:
#   podman build -t agent-sandbox-demo:1 -f src/rootless-container/Containerfile .
# Pin BASE_IMAGE by digest for real runs.
ARG BASE_IMAGE=docker.io/library/python:3.12-slim-bookworm
FROM ${BASE_IMAGE}

RUN useradd --uid 1000 --create-home --shell /usr/sbin/nologin agent
# src/ is mounted at run time, not copied in. Uncomment for --agent:
# RUN pip install --no-cache-dir --break-system-packages "aider-chat==0.86.2"

USER 1000:1000
WORKDIR /work
ENV HOME=/tmp/home PYTHONDONTWRITEBYTECODE=1
ENTRYPOINT ["/bin/bash", "/src/common/inside.sh"]
