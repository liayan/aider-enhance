# Build from the repo root:
#   podman build -t agent-sandbox-demo:1 -f src/rootless-container/Containerfile .
# Add --build-arg WITH_AIDER=1 for --agent runs.
# Pin BASE_IMAGE by digest for real runs.
ARG BASE_IMAGE=docker.io/library/python:3.12-slim-bookworm
FROM ${BASE_IMAGE}

RUN useradd --uid 1000 --create-home --shell /usr/sbin/nologin agent
# src/ is mounted at run time, not copied in.
ARG WITH_AIDER=0
ARG AIDER_VERSION=0.86.2
RUN if [ "$WITH_AIDER" = 1 ]; then \
      pip install --no-cache-dir --break-system-packages "aider-chat==${AIDER_VERSION}"; \
    fi
LABEL demo.with_aider=${WITH_AIDER}

USER 1000:1000
WORKDIR /work
ENV HOME=/tmp/home PYTHONDONTWRITEBYTECODE=1
ENTRYPOINT ["/bin/bash", "/src/common/inside.sh"]
